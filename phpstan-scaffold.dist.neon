# The scaffold is copied as is into the applications (see ScaffoldInstaller), which are analysed at level 6: what passes here at level 5 with the rest of the bundle comes back as an error on their first push. Hence this second pass, dedicated to the scaffold and set at the applications' own level.
parameters:
    level: 6

    # The ignored patterns below are shared by every c975L bundle, so not all of them apply to each one
    reportUnmatchedIgnoredErrors: false

    paths:
        - scaffold/src
        - scaffold/tests

    excludePaths:
        # These need an application kernel and a browser-kit the bundle does not install, which is why phpunit.xml.dist skips them too
        - scaffold/tests/Controller/*

    ignoreErrors:
        # Doctrine assigns the identifier by reflection, which static analysis cannot see - the applications load phpstan-doctrine, which knows about it
        - '#Property .*::\$id \(int\|null\) is never assigned int#'

        # PHP Mess Detector's own marker, which PHPStan reads as a typed tag and cannot parse - see the phpmd.xml.dist beside this file
        - identifier: phpDoc.parseError
