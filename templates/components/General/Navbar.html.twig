{# <twig:c975LSite:General:Navbar [page="{{ page }}"]> #}
{% set logo = site_media('logo') %}
{# The same logo drawn for a dark page, uploaded on its own site-graphic role (see UiBundle's Media::ROLE_LOGO_ON_DARK). Written beside the other one and hidden by the stylesheet rather than picked here: which of the two is read depends on the visitor's own system when theme-mode is "auto", something no template knows. A site that uploaded none writes one image, exactly as before #}
{% set logoOnDark = site_media('logo-on-dark') %}
{# Only a site carrying both gets the pair the stylesheet switches between. One alone is painted on either ground, whichever of the two it is: a site that uploaded only the dark one is a site whose logo is meant to be read that way, not a site without a logo #}
{% set hasLogoPair = logo is not null and logoOnDark is not null %}
{% set anyLogo = logo ?? logoOnDark %}
{% set siteName = config('site-name') %}
{% set showSiteName = config('site-navbar-show-name') %}
{# Read by both branches below, hence set here: a "set" inside the first one never runs on the fallback bar #}
{% set showBrandName = showSiteName and siteName is not null %}
{# Whitelisted: it lands in a custom property, which Twig's html_attr context doesn't escape #}
{% set navbarPosition = config('site-navbar-position') in ['relative', 'sticky', 'fixed', 'static', 'absolute'] ? config('site-navbar-position') : null %}
{# "static" and "relative" sit identically in the flow, but only the latter is a containing block for the mobile dropdown hanging off the bar #}
{% set navbarPosition = navbarPosition == 'static' ? 'relative' : navbarPosition %}

{% if menu_blocks('navbar') is not empty %}
    {# Empty leaves the --navbar-position default; "fixed" also needs .menu-fixed for its z-index #}
    <nav class="hidden-print menu{{ navbarPosition == 'fixed' ? ' menu-fixed' : '' }}{{ navbarPosition ? ' menu-position-' ~ navbarPosition : '' }}" data-controller="menu">
        <div class="menu-header">
            <div class="menu-brand">
                {# Logo and site name both point at the home page: one single link around the pair, where two adjacent ones made a screen reader announce the same destination twice in a row #}
                <div class="menu-brand-top">
                    {% if anyLogo is not null or showBrandName %}
                        <a href="{{ path('page_home') }}" class="menu-brand-link">
                            {% if anyLogo is not null %}
                                <span class="menu-logo">
{# eager, the navbar logo being above the fold on every page; intrinsic dimensions, the free-text width/height possibly holding an unusable "50%" and older rows neither, hence the fallback; and decorative once the name is printed beside it inside the same link, aria-hidden saying so outright rather than leaving an empty alt to be read as an oversight #}
                                    {% if logo is not null %}
                                        <img{% if hasLogoPair %} class="menu-logo__on-light"{% endif %} src="{{ asset('/' ~ logo.filename) }}{{ logo.updatedAt ? '?v=' ~ logo.updatedAt.timestamp : '' }}" alt="{{ showBrandName ? '' : siteName|default('Logo') }}"{% if showBrandName %} aria-hidden="true"{% endif %}{% if logo.intrinsicWidth and logo.intrinsicHeight %} width="{{ logo.intrinsicWidth }}" height="{{ logo.intrinsicHeight }}"{% else %} height="40"{% endif %} loading="eager" fetchpriority="high">
                                    {% endif %}
                                    {% if logoOnDark is not null %}
{# The twin of the one above, named exactly like it: the CSS paints one of the two and takes the other out of the accessibility tree, so the name sits on both or the theme showing this one leaves the home link unnamed. Lazy and without a priority, a browser leaving a hidden lazy image alone until it is shown - standing alone it takes back the priority a pair drops #}
                                        <img{% if hasLogoPair %} class="menu-logo__on-dark"{% endif %} src="{{ asset('/' ~ logoOnDark.filename) }}{{ logoOnDark.updatedAt ? '?v=' ~ logoOnDark.updatedAt.timestamp : '' }}" alt="{{ showBrandName ? '' : siteName|default('Logo') }}"{% if showBrandName %} aria-hidden="true"{% endif %}{% if logoOnDark.intrinsicWidth and logoOnDark.intrinsicHeight %} width="{{ logoOnDark.intrinsicWidth }}" height="{{ logoOnDark.intrinsicHeight }}"{% else %} height="40"{% endif %}{{ hasLogoPair ? ' loading="lazy"' : ' loading="eager" fetchpriority="high"' }}>
                                    {% endif %}
                                </span>
                            {% endif %}

                            {% if showBrandName %}
                                <span class="menu-site-name">{{ siteName }}</span>
                            {% endif %}
                        </a>
                    {% endif %}
                </div>

                {# The tagline, and anything else the site says under its own name: blocks of the "navbar-brand" menu, so it is written once and read in each of the site's languages - it was the "site-tagline" setting, which a config entry says in one language to everyone #}
                {% if menu_blocks('navbar-brand') is not empty %}
                    <div class="menu-site-tagline">
                        <twig:c975LUi:Blocks:Blocks blocks="{{ menu_blocks('navbar-brand') }}" />
                    </div>
                {% endif %}
            </div>

            {# The site search's magnifier, next to the burger so a phone reaches it without opening the menu - its desktop twin ends the links below. UiBundle writes nothing while the search is off #}
            <twig:c975LUi:AiSearch:Trigger class="menu-ai-search menu-ai-search--mobile" />

            <button class="menu-toggle" data-action="click->menu#toggle" aria-label="{{ 'menu.toggle'|trans({}, 'site') }}" aria-expanded="false">
                <svg class="menu-toggle-icon" viewBox="0 0 448 512" aria-hidden="true" focusable="false">
                    <path d="M0 96C0 78.3 14.3 64 32 64H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 128 0 113.7 0 96zM0 256c0-17.7 14.3-32 32-32H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32zM448 416c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32H416c17.7 0 32 14.3 32 32z"/>
                </svg>
            </button>
        </div>

        <div class="menu-items" data-menu-target="items">
            <twig:c975LUi:Blocks:Blocks blocks="{{ menu_blocks('navbar') }}" />
            <twig:c975LUi:AiSearch:Trigger class="menu-ai-search menu-ai-search--desktop" />
{# Inside the items and not beside them: on a phone the bar collapses into that dropdown, and a language menu left outside it would sit alone next to the burger #}
            <twig:c975LSite:General:Languages page="{{ page|default(null) }}" />
        </div>
    </nav>
{% else %}
    <nav class="hidden-print nav-simple">
        {# One link around the logo and the name, as on the menu brand above, two adjacent links having had a screen reader announce that destination twice; site-navbar-show-name answers "show the name in the navbar", and this is the navbar a site with no menu blocks gets #}
        {% if anyLogo is not null or showBrandName %}
            <a href="{{ path('page_home') }}" class="nav-simple-brand">
{# eager and decorative, same reasons as the menu logo above: an alt inside the same link as the name would have that link read its own name twice #}
                {% if logo is not null %}
                    <img src="{{ asset('/' ~ logo.filename) }}" alt="{{ showBrandName ? '' : siteName|default('Logo') }}"{% if showBrandName %} aria-hidden="true"{% endif %} class="img{% if hasLogoPair %} menu-logo__on-light{% endif %}" height="70" loading="eager" fetchpriority="high">
                {% endif %}
{# The dark counterpart, on the fallback bar too: same pair, same switch and same reasons as the menu brand above #}
                {% if logoOnDark is not null %}
                    <img src="{{ asset('/' ~ logoOnDark.filename) }}" alt="{{ showBrandName ? '' : siteName|default('Logo') }}"{% if showBrandName %} aria-hidden="true"{% endif %} class="img{% if hasLogoPair %} menu-logo__on-dark{% endif %}" height="70"{{ hasLogoPair ? ' loading="lazy"' : ' loading="eager" fetchpriority="high"' }}>
                {% endif %}

                {% if showBrandName %}
                    <span class="nav-simple-name">{{ siteName }}</span>
                {% endif %}
            </a>
        {% endif %}

        <twig:c975LUi:AiSearch:Trigger />

{# The bar a site with no menu blocks gets, which is still a site a visitor has to be able to read in their own language #}
        <twig:c975LSite:General:Languages page="{{ page|default(null) }}" />
    </nav>
{% endif %}