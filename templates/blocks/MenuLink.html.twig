{# Resolves "target" into a link, rendering nothing when it no longer resolves #}
{% set url = menu_link_url(target) %}
{% if url is not empty %}
    {# "label" overrides the derived one; a link left to the copyright page's computed notice is rendered live, so its year stays fresh (see MenuExtension::getMenuLinkCacheTags) #}
    {% set resolvedLabel = label|default('') is not empty ? label : menu_link_label(target) %}
    {# No active state here: the html is cached and shared by every page, menu-active.js marks the item of the page being read #}
    {# Nor any visitor check, for the same reason: a guests/members link is written for everyone with a marker class, which the layout's "is-guest"/"is-member" body class hides (see _menu.scss) #}
    {% set visibilityClass = visibility|default('all') in ['guests', 'members'] ? 'menu-item--' ~ visibility : null %}
    <div class="{{ ['menu-item', primary|default(false) ? 'menu-item--primary' : null, strong|default(false) ? 'menu-item--strong' : null, visibilityClass]|filter(v => v is not null)|join(' ') }}">
        <a href="{{ url }}" class="menu-link">
            <span class="menu-label">{{ resolvedLabel }}</span>
        </a>
    </div>
{% endif %}
