{# Blocks are managed independently from the site footer's, via the "email-footer" Menu location #}
{# An email has no visitor to show a guests/members only link to, nor a link to a page kept for members, so it leaves them out rather than send them to everyone, a group's links included (see MenuExtension::getEmailMenuBlocks()) #}
{% set blocks = menu_email_blocks('email-footer') %}
{% if blocks is not empty %}
    {# One centered inline list rather than the page footer's colored band: an email footer is a discreet row of links, styled like the "layout_sent_by" line right below it (see sass/_email-footer.scss) #}
    <div class="email-footer text-center">
        <ul class="inline">
            {% for block in blocks %}
                <li>{{ render_block(block) }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
