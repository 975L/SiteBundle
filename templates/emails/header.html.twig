{# Blocks are managed independently from the site header's, via the "email-header" Menu location #}
{# An email has no visitor to show a guests/members only link to, nor a link to a page kept for members, so it leaves them out rather than send them to everyone, a group's links included (see MenuExtension::getEmailMenuBlocks()) #}
{% for block in menu_email_blocks('email-header') %}
    {{ render_block(block) }}
{% endfor %}
