{% set site = config('site-name') %}
{% set author = config('site-author') %}
{% if site_media('logo') is not null %}
    {% set logo = config('site-url') ~ '/' ~ site_media('logo').filename %}
{% endif %}

{# Copyright #}
{% set copyright = site_copyright() %}

{# Every root-relative path this layout wraps is made absolute: an email is read outside the site, where "/medias/…" resolves against nothing #}
{% apply inline_css|absolute_urls(config('site-url')) %}
<!DOCTYPE html>
    {# Head #}
    <head>
        {% block head %}
            {% block meta %}
                <meta charset="utf-8" />
                <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
{# Comma-separated, same fix as layout.html.twig - without them the whole directive is one unparseable token. "maximum-scale"/"user-scalable" dropped along the way: locking the zoom leaves anyone who needs to enlarge the text with no way to do it #}
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <meta name="format-detection" content="telephone=no" />
                {# Author #}
                {% if author is defined %}
                    <meta name="author" content="{{ author }}" />
                {% endif %}
                {# Copyright #}
                {% if copyright is defined %}
                    <link rel="copyright" title="{{ copyright }}" />
                {% endif %}
            {% endblock %}
            {# Stylesheets #}
            {% block stylesheets %}
                <style>
                    {# UiBundle's shared email base first - it carries the :root defaults and everything the EmailTemplate blocks render against. This bundle's own file then brings the branded footer alone, and the admin's theme variables win last. "resolve_css_variables" then replaces every var() by the value it resolves to: the inliner below copies declarations into style="" verbatim, and Gmail, Outlook and most mobile clients resolve no custom property - every colored declaration was dropped there. It runs at render time, not at sass compile time, so the admin's own palette (theme_variables_css above) is part of what gets resolved #}
                    {% apply resolve_css_variables %}
                        {{ source('@c975LUiCss/emails.min.css') }}
                        {{ source('@c975LSiteCss/emails.min.css') }}
                        {{ theme_variables_css() }}
                    {% endapply %}
                </style>
            {% endblock %}
        {% endblock %}
    </head>
    {# Body #}
    <body>
        {% block body %}
            {# Header #}
            {% block header %}
                {# No Spam info #}
                {% block noSpam %}
                    {% if config('email-text-no-spam') %}
                        {{ config('email-text-no-spam')|raw }}
                    {% endif %}
                {% endblock %}
                {# Logo #}
                {% block logo %}
                    <h1 class="text-center">
                        {% if logo is defined %}
                            <img src="{{ logo }}" height="50" alt="logo" />
                        {% elseif site is defined %}
                            {{ site }}
                        {% endif %}
                    </h1>
                {% endblock %}
                {# User's header #}
                {% include '@c975LSite/emails/header.html.twig' %}
            {% endblock %}
            {# Container #}
            {% block container %}
                {# Content #}
                {% block content %}
                    {# Hello #}
                    {% block hello %}
                        {% if config('email-text-hello') %}
                            {{ config('email-text-hello')|raw }}
                        {% endif %}
                    {% endblock %}
                    {% block email_content %}
                    {% endblock %}
                {% endblock %}
            {% endblock %}
            {# Footer #}
            {% block footer %}
                <hr />
                {# Thanks confidence & regards #}
                {% if config('email-text-closing') %}
                    {{ config('email-text-closing')|replace({'%site%': site|default('')})|raw }}
                {% endif %}
                {# User's footer - the "email-footer" Menu, which adds to what follows and never stands in for it #}
                {% include '@c975LSite/emails/footer.html.twig' %}
                {# Where a prospection e-mail places its way out (article L34-5 CPCE); a transactional one owes none #}
                {% block emailUnsubscribe %}{% endblock %}
                {# Email sent by #}
                {% if config('email-text-sent-by') %}
                    {{ config('email-text-sent-by')|replace({'%site%': site|default('')})|raw }}
                {% endif %}
                {# Who sends this e-mail, owed by every commercial document (LCEN art. 6-III, C. com. art. R123-237) #}
                {% if config('site-owner') %}
                    <p class="text text-muted text-center small">
                        {{ config('site-owner')|raw }}
                    </p>
                {% endif %}
                {# Link to what is done with the recipient's data, which article 13 asks to be reachable #}
                {% if config('url-privacy-policy') %}
                    <p class="text text-muted text-center small">
                        <a href="{{ config('url-privacy-policy') }}">{{ 'label.privacy_policy'|trans({}, 'site') }}</a>
                    </p>
                {% endif %}
                {# Copyright #}
                {% if copyright is defined %}
                    <div class="text-center">
                        <ul class="inline">
                            <li>{{ copyright }}</li>
                        </ul>
                    </div>
                {% endif %}
            {% endblock %}
        {% endblock %}
    </body>
</html>
{% endapply %}