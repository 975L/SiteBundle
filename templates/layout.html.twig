{# The site foundation's page shell. UiBundle's layout is the single source for the <head> and the page skeleton; this one adds only what having Pages, menus and a navbar brings, so nothing is written twice and no tag can drift between the two #}
{# The sets below run before the parent (Twig compiles a child's body ahead of the parent's yield) and translate this bundle's entities into the plain variables the parent reads - it knows nothing of Page, Menu or Navbar #}
{% extends '@c975LUi/layout.html.twig' %}

{# The Page's own share image opens the parent's cascade, ahead of the url's row, the site's default og-image and the logo. Resolved here rather than by the template rendering the Page, which would otherwise have to know the whole cascade #}
{% if (ogImage is not defined or ogImage == null) and page is defined and page.ogImage is not null %}
    {% set ogImageMedia = page.ogImage %}
{% endif %}

{# A Page says in a column whether its title is printed as the page heading; templates with no Page behind them keep printing theirs #}
{% if page is defined %}
    {% set headingDisplayed = page.isTitleDisplayed %}
{% endif %}

{# A navbar taken out of the flow needs the body to make room for it, on every page of the site. Appended rather than assigned: a child layout's own set runs before this one, so assigning would silently drop whatever an app declared #}
{% if config('site-navbar-position') == 'fixed' %}
    {% set bodyClasses = bodyClasses|default('') ~ 'navbar-fixed ' %}
{% endif %}

{# This bundle's own Stimulus controller, added next to the ones the parent and any app layout declare #}
{% set bodyControllers = (bodyControllers|default('') ~ ' basic')|trim %}

{% block header %}
    <header>
        {% block navigation %}
            <twig:c975LSite:General:Navbar />
        {% endblock %}
    </header>
{% endblock %}

{# The parent leaves the content unwrapped; a site centers it on its grid #}
{% block container %}
    <div class="container">
        {{ parent() }}
    </div>
{% endblock %}

{% block footer %}
    {# No site name, matching what a "Copyright"-page menu_link shows instead #}
    <twig:c975LSite:General:Footer copyright="{{ site_copyright(false) }}" />
{% endblock %}
