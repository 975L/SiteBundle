{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block main %}
    <p>{{ ('label.info_site_graphic'|trans({}, 'site')) }}</p>

    {# One button per graphic still missing: it opens the upload form with the role already picked #}
    {% if missing_roles|default([]) is not empty %}
        <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
            <span>{{ ('label.create_site_graphic'|trans({}, 'site')) }}</span>
            {% for missing in missing_roles %}
                <a href="{{ missing.url }}" class="btn btn-secondary">
                    <i class="fa fa-plus"></i> {{ missing.label }}
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {{ parent() }}
{% endblock main %}
