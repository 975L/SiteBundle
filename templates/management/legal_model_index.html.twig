{% extends '@EasyAdmin/page/content.html.twig' %}

{% block main %}
    <h1>{{ ('label.legal_models'|trans({}, 'site')) }}</h1>

    <p>{{ ('label.info_legal_model'|trans({}, 'site')) }}</p>

    {% if rows|length > 0 %}
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ ('label.page'|trans({}, 'site')) }}</th>
                        <th>{{ ('label.model'|trans({}, 'site')) }}</th>
                        <th>{{ ('label.legal_unit_hidden'|trans({}, 'site')) }}</th>
                        <th>{{ ('label.legal_units_overridden'|trans({}, 'site')) }}</th>
                        <th>{{ ('label.legal_extra_sections'|trans({}, 'site')) }}</th>
                        <th>{{ ('label.legal_drift'|trans({}, 'site')) }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr>
                        <td>
                            {{ row.page.title }}
                            {% if not row.page.isPublished %}
                                <span class="badge badge-secondary">{{ ('label.not_published'|trans({}, 'site')) }}</span>
                            {% endif %}
                        </td>
                        <td>{{ (row.label|trans({}, 'site')) }}</td>
                        <td>{{ row.hidden ?: '-' }}</td>
                        <td>{{ row.overridden ?: '-' }}</td>
                        <td>{{ row.extra ?: '-' }}</td>
                        <td>
                            {% if row.drifted > 0 %}
                                <span class="badge badge-info">{{ ('label.legal_drift_count'|trans({'%count%': row.drifted}, 'site')) }}</span>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td class="text-nowrap">
                            <a href="{{ path('management_site_legal_model_customize', {block: row.block.id}) }}" class="btn btn-sm btn-outline-primary">
                                {{ ('label.legal_customize'|trans({}, 'site')) }}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>{{ ('label.legal_models_none'|trans({}, 'site')) }}</p>
    {% endif %}
{% endblock main %}
