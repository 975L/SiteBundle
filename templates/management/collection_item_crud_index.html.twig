{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block main %}
    <p>{{ ('label.info_collection_item_list'|trans({}, 'site')) }}</p>

    {{ parent() }}
{% endblock main %}

{# Opts each row into UiBundle's ea-index-sort.js; the index is always filtered to one collection, the group being carried all the same so a tampered payload is refused server-side #}
{% block entity_row_attributes %}
    data-reorder-group="{{ entity.instance.collectionGroup.id }}"
    data-reorder-url="{{ ea_url().setAction('reorder') }}"
    data-reorder-token="{{ csrf_token('collection_item_reorder') }}"
{% endblock %}
