{# The app's own file first, not "@c975LSite/layout.html.twig" directly: it resolves here anyway (it extends ['@c975LSite/layout.html.twig', '@c975LUi/layout.html.twig']), but going through it is what lets a site add its own blocks around the layout and have them apply to its pages too, as they already do to the scaffolded error templates. The bundle's own layout stays as a fallback, for an app that hasn't run the scaffold #}
{% extends ['layout.html.twig', '@c975LSite/layout.html.twig'] %}

{# The collection item's own title, rather than the parent Page's generic one #}
{% set title = detailTitle is defined and detailTitle ? detailTitle : page.title %}
{% set summarySocialNetwork = page.summarySocialNetwork %}

{# Read by layout's "meta" block, which defaults to "index, follow" for every other template #}
{% set robots = page.isIndexable ? 'index, follow' : 'noindex, follow' %}

{# Overrides "container" so blocks render full-width beside the alerts; the div is dropped when empty, its padding opening a gap otherwise #}
{% block container %}
    {% if isPreview|default(false) and not page.isPublished %}
        <div class="container">
            <twig:c975LUi:Alert:Alert type="warning" message="{{ 'label.preview_mode'|trans({}, 'site') }}" />
        </div>
    {% endif %}
    {% if detailHtml is defined and detailHtml %}
        {# Already-rendered HTML standing in for the Page's blocks, the URL having resolved to a collection item #}
        {{ detailHtml|raw }}
    {% else %}
        <twig:c975LUi:Blocks:Blocks blocks="{{ page.blocks }}" />
    {% endif %}
{% endblock %}