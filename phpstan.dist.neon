parameters:
    level: 5

    # The ignored patterns below are shared by every c975L bundle, so not all of them apply to each one
    reportUnmatchedIgnoredErrors: false

    paths:
        - src
        - scaffold/src
        - scaffold/tests

    excludePaths:
        # The skeleton templates get their variables from the maker at generation time
        - src/Resources/skeleton/*

        # These need an application kernel and a browser-kit the bundle does not install, which is why phpunit.xml.dist skips them too
        - scaffold/tests/Controller/*

    ignoreErrors:
        # Doctrine assigns the identifier by reflection, which static analysis cannot see
        - '#Property .*::\$id \(int\|null\) is never assigned int#'

        # EasyAdmin declares its fluent setters on the concrete fields, not on FieldInterface
        - '#Call to an undefined method EasyCorp\\Bundle\\EasyAdminBundle\\Contracts\\Field\\FieldInterface::#'

        # The only reader of a HasBlocksInterface entity's $blocks is UiBundle's HasBlocksTrait, analysed with its own package and not with this one
        - '#Property .*::\$blocks is never read, only written#'

        # PHP Mess Detector's own marker, which PHPStan reads as a typed tag and cannot parse - see the phpmd.xml.dist beside this file
        - identifier: phpDoc.parseError
