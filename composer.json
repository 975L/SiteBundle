{
    "name": "c975l/site-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle that turns the c975L core into a complete website — full layout, database-driven pages, navbar and footer menus, collections, branded emails, per-page SEO and health check.",
    "keywords": [
        "symfony",
        "bundle",
        "website"
    ],
    "homepage": "https://github.com/975L/SiteBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Laurent Marquet",
            "email": "laurent.marquet@laposte.net",
            "homepage": "https://github.com/LaurentMarquet",
            "role": "Developer"
        },
        {
            "name": "975L Community",
            "homepage": "https://github.com/975L"
        }
    ],
    "require": {
        "php": ">=8.4",
        "c975l/core-bundle": "^1.18",
        "doctrine/orm": "^3.6",
        "easycorp/easyadmin-bundle": "^5.1",
        "endroid/qr-code": "^6",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/string": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/ux-twig-component": "^3.3",
        "twig/cssinliner-extra": "^3.26",
        "twig/intl-extra": "^3.26",
        "twig/twig": "^3.26",
        "vich/uploader-bundle": "^2.9"
    },
    "require-dev": {
        "nelmio/security-bundle": "^3.9",
        "phpunit/phpunit": "^13.2"
    },
    "suggest": {
        "nelmio/security-bundle": "Enables layout.html.twig's CSP nonce on Turbo-executed scripts - the Turbo-safe nonce generator behind it now ships with ConfigBundle"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "c975L\\SiteBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "c975L\\SiteBundle\\Tests\\": "tests/",
            "App\\": "scaffold/src/",
            "App\\Tests\\": "scaffold/tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "audit-deps": "composer audit --abandoned=report",
        "cs": "phpcs -q",
        "fixer": "php-cs-fixer check --diff",
        "stan": "phpstan analyse --no-progress",
        "stan-scaffold": "phpstan analyse -c phpstan-scaffold.dist.neon --no-progress",
        "rector": "rector process --dry-run",
        "test": "phpunit",
        "qa": [
            "@audit-deps",
            "@cs",
            "@fixer",
            "@stan",
            "@stan-scaffold",
            "@rector",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "cs": "PSR-12 (phpcs)",
        "fixer": "Standard Symfony (php-cs-fixer)",
        "stan": "Analyse statique du bundle, level 5",
        "stan-scaffold": "Analyse statique du seul scaffold, level 6, au niveau des applications qui le recopient",
        "rector": "Modernisation du code (rector), en dry-run - le cache est dans .rector.cache, propre au dépôt",
        "test": "Suite PHPUnit",
        "qa": "Tous les contrôles de la CI, dans l'ordre - voir bin/ci.sh pour les rejouer sur des dépendances fraîches"
    },
    "support": {
        "email": "contact@975l.com",
        "source": "https://github.com/975L/SiteBundle",
        "issues": "https://github.com/975L/SiteBundle/issues"
    }
}
