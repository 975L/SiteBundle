{
    "name": "c975l/site-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle that provides a complete foundation for building websites — layout, pages, SEO, admin, sitemap, legal templates, and more.",
    "keywords": ["symfony", "bundle", "website"],
    "homepage": "https://github.com/975L/SiteBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Laurent Marquet",
            "email": "laurent.marquet@laposte.net",
            "homepage": "https://github.com/LaurentMarquet",
            "role": "Developer"
        },
        {
            "name": "975L Community",
            "homepage": "https://github.com/975L"
        }
    ],
    "require": {
        "php": ">=8.4",
        "c975l/config-bundle": "^5.16",
        "c975l/ui-bundle": "^1.17",
        "doctrine/orm": "^3.6",
        "dragonmantank/cron-expression": "^3.6",
        "easycorp/easyadmin-bundle": "^5.1",
        "endroid/qr-code": "^6",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/process": "^8.0",
        "symfony/rate-limiter": "^8.0",
        "symfony/scheduler": "^8.0",
        "symfony/string": "^8.0",
        "symfony/ux-twig-component": "^3.3",
        "symfonycasts/reset-password-bundle": "^1.25",
        "symfonycasts/verify-email-bundle": "^1.18",
        "twig/cssinliner-extra": "^3.26",
        "twig/intl-extra": "^3.26",
        "vich/uploader-bundle": "^2.9"
    },
    "require-dev": {
        "nelmio/security-bundle": "^3.9",
        "phpunit/phpunit": "^13.2"
    },
    "suggest": {
        "c975l/social-bundle": "Adds the share buttons band to layout.html.twig, and the social links block",
        "nelmio/security-bundle": "Enables layout.html.twig's CSP nonce on Turbo-executed scripts, and a Turbo-safe session-based nonce generator instead of Nelmio's default per-request one"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "c975L\\SiteBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "c975L\\SiteBundle\\Tests\\": "tests/",
            "App\\": "scaffold/src/",
            "App\\Tests\\": "scaffold/tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "support": {
        "email": "contact@975l.com",
        "source": "https://github.com/975L/SiteBundle",
        "issues": "https://github.com/975L/SiteBundle/issues"
    }
}
