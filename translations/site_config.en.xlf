<?xml version="1.0"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="en" datatype="plaintext" original="site_config.en.xlf">
        <body>
            <trans-unit id="o3sVBy1">
                <source>description.email_debug</source>
                <target>When enabled, a ROLE_SUPER_ADMIN sees a preview instead of a real send</target>
            </trans-unit>
            <trans-unit id="iDg56gE">
                <source>description.email_text_closing</source>
                <target>Thank-you/signature at the bottom of the email. %site% inserts the site name (HTML allowed, not translated). Empty = nothing.</target>
            </trans-unit>
            <trans-unit id="3PPdNBL">
                <source>description.email_text_hello</source>
                <target>Greeting at the top of the email (HTML allowed, not translated). Empty = nothing.</target>
            </trans-unit>
            <trans-unit id="YRufMZi">
                <source>description.email_text_legal</source>
                <target>Free text at the bottom of the email for legal mentions (legal form, share capital, reg. number...) (HTML allowed, not translated). Empty = nothing.</target>
            </trans-unit>
            <trans-unit id="gH2Y6PX">
                <source>description.email_text_no_spam</source>
                <target>"No spam" notice at the top of the email (HTML allowed, not translated). Empty = nothing.</target>
            </trans-unit>
            <trans-unit id="nP1tx85">
                <source>description.email_text_sent_by</source>
                <target>"Sent by..." notice at the bottom of the email. %site% inserts the site name (HTML allowed, not translated).</target>
            </trans-unit>
            <trans-unit id="ysqN9bN">
                <source>description.healthcheck_pagespeed_api_key</source>
                <target>Optional - raises Google's PageSpeed Insights rate limit for the c975l:health-check:run command. Get one at https://developers.google.com/speed/docs/insights/v5/get-started</target>
            </trans-unit>
            <trans-unit id="imDzV_g">
                <source>description.site_enable_matomo</source>
                <target>Enables Matomo, deliberately outside the cookie banner - only for a CNIL-exempt setup (anonymized IP, no cross-site tracking, cookie ≤13 months, DNT respected)</target>
            </trans-unit>
            <trans-unit id="QbsOHOo">
                <source>description.site_matomo_id</source>
                <target>Matomo site ID (integer)</target>
            </trans-unit>
            <trans-unit id="X8T2_9z">
                <source>description.site_matomo_url</source>
                <target>URL of the Matomo instance i.e. https://matomo.example.com</target>
            </trans-unit>
            <trans-unit id="oVvC_MZ">
                <source>description.site_menu_link_copyright_auto</source>
                <target>Show the computed copyright (© year) as the menu link label for the "Copyright" page, instead of its title</target>
            </trans-unit>
            <trans-unit id="Mnh5Cya">
                <source>description.site_navbar_position</source>
                <target>CSS position of the navbar: relative (default), sticky, fixed, static...</target>
            </trans-unit>
            <trans-unit id="sZpIxHm">
                <source>description.site_navbar_show_name</source>
                <target>Show the site name (and tagline) next to the logo in the navbar</target>
            </trans-unit>
            <trans-unit id="ah0x8VP">
                <source>description.site_preconnect</source>
                <target>Origins to preconnect (JSON array), e.g. ["https://example.com"] - useful when credits/Matomo logos are on a third-party domain</target>
            </trans-unit>
            <trans-unit id="EuVrG.1">
                <source>description.site_tagline</source>
                <target>Tagline of the website</target>
            </trans-unit>
            <trans-unit id=".HY9J1w">
                <source>label.email_debug</source>
                <target>Email debug mode</target>
            </trans-unit>
            <trans-unit id="0yPWZIz">
                <source>label.email_text_closing</source>
                <target>Email Thank-You And Signature Text</target>
            </trans-unit>
            <trans-unit id="ZewvoKr">
                <source>label.email_text_hello</source>
                <target>Email Greeting</target>
            </trans-unit>
            <trans-unit id="gRiag_n">
                <source>label.email_text_legal</source>
                <target>Email Extra Legal Mentions</target>
            </trans-unit>
            <trans-unit id="S7SABir">
                <source>label.email_text_no_spam</source>
                <target>Email No-Spam Text</target>
            </trans-unit>
            <trans-unit id="cPmYzbj">
                <source>label.email_text_sent_by</source>
                <target>Email "Sent By" Notice</target>
            </trans-unit>
            <trans-unit id="wkcUWqy">
                <source>label.healthcheck_pagespeed_api_key</source>
                <target>PageSpeed Insights API key</target>
            </trans-unit>
            <trans-unit id="xZcUaF_">
                <source>label.site_enable_matomo</source>
                <target>Enable Matomo Analytics</target>
            </trans-unit>
            <trans-unit id="EDDAHIQ">
                <source>label.site_matomo_id</source>
                <target>Matomo Site ID</target>
            </trans-unit>
            <trans-unit id="HoL37ro">
                <source>label.site_matomo_url</source>
                <target>Matomo URL</target>
            </trans-unit>
            <trans-unit id="vnrrGUG">
                <source>label.site_menu_link_copyright_auto</source>
                <target>Automatic copyright on the "Copyright" page menu link</target>
            </trans-unit>
            <trans-unit id="xYIFis1">
                <source>label.site_navbar_position</source>
                <target>Navbar position</target>
            </trans-unit>
            <trans-unit id="GKSaIC2">
                <source>label.site_navbar_show_name</source>
                <target>Show Site Name In Navbar</target>
            </trans-unit>
            <trans-unit id="MhX0IMV">
                <source>label.site_preconnect</source>
                <target>Preconnect URLs</target>
            </trans-unit>
            <trans-unit id="tN9lVY3">
