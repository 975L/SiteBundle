<?xml version="1.0"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="es" datatype="plaintext" original="site_config.es.xlf">
        <body>
            <trans-unit id="o3sVBy1">
                <source>description.email_debug</source>
                <target>Si activado, ROLE_SUPER_ADMIN ve una vista previa en vez de un envío real</target>
            </trans-unit>
            <trans-unit id="iDg56gE">
                <source>description.email_text_closing</source>
                <target>Agradecimiento/firma al final del correo. %site% inserta el nombre del sitio (HTML permitido, no traducido). Vacío = nada.</target>
            </trans-unit>
            <trans-unit id="3PPdNBL">
                <source>description.email_text_hello</source>
                <target>Saludo en la parte superior del correo (HTML permitido, no traducido). Vacío = nada.</target>
            </trans-unit>
            <trans-unit id="YRufMZi">
                <source>description.email_text_legal</source>
                <target>Texto libre al final del correo para menciones legales (forma jurídica, capital, número de registro...) (HTML permitido, no traducido).</target>
            </trans-unit>
            <trans-unit id="gH2Y6PX">
                <source>description.email_text_no_spam</source>
                <target>Aviso "anti-spam" en la parte superior del correo (HTML permitido, no traducido). Vacío = nada.</target>
            </trans-unit>
            <trans-unit id="nP1tx85">
                <source>description.email_text_sent_by</source>
                <target>Mención "Enviado por..." al final del correo. %site% inserta el nombre del sitio (HTML permitido, no traducido).</target>
            </trans-unit>
            <trans-unit id="ysqN9bN">
                <source>description.healthcheck_pagespeed_api_key</source>
                <target>Opcional - aumenta el límite de peticiones de Google PageSpeed Insights para el comando c975l:health-check:run. Consíguela en https://developers.google.com/speed/docs/insights/v5/get-started</target>
            </trans-unit>
            <trans-unit id="imDzV_g">
                <source>description.site_enable_matomo</source>
                <target>Activa Matomo, fuera del banner de cookies - solo para configuración exenta CNIL (IP anonimizada, sin cruce entre sitios, cookie ≤13 meses, DNT respetado)</target>
            </trans-unit>
            <trans-unit id="QbsOHOo">
                <source>description.site_matomo_id</source>
                <target>ID del sitio Matomo (entero)</target>
            </trans-unit>
            <trans-unit id="X8T2_9z">
                <source>description.site_matomo_url</source>
                <target>URL de la instancia de Matomo, ej. https://matomo.example.com</target>
            </trans-unit>
            <trans-unit id="oVvC_MZ">
                <source>description.site_menu_link_copyright_auto</source>
                <target>Mostrar el copyright calculado (© año) como etiqueta del enlace a la página "Copyright", en vez de su título</target>
            </trans-unit>
            <trans-unit id="Mnh5Cya">
                <source>description.site_navbar_position</source>
                <target>Posición CSS de la navbar: relative (por defecto), sticky, fixed, static...</target>
            </trans-unit>
            <trans-unit id="sZpIxHm">
                <source>description.site_navbar_show_name</source>
                <target>Mostrar el nombre (y el eslogan) junto al logo en la barra de navegación</target>
            </trans-unit>
            <trans-unit id="ah0x8VP">
                <source>description.site_preconnect</source>
                <target>Orígenes a preconectar (array JSON), ej. ["https://example.com"] - útil si logos de créditos/Matomo están en otro dominio</target>
            </trans-unit>
            <trans-unit id="EuVrG.1">
                <source>description.site_tagline</source>
                <target>Eslogan del sitio web</target>
            </trans-unit>
            <trans-unit id=".HY9J1w">
                <source>label.email_debug</source>
                <target>Modo debug de emails</target>
            </trans-unit>
            <trans-unit id="0yPWZIz">
                <source>label.email_text_closing</source>
                <target>Texto de agradecimiento y firma del correo</target>
            </trans-unit>
            <trans-unit id="ZewvoKr">
                <source>label.email_text_hello</source>
                <target>Saludo del correo</target>
            </trans-unit>
            <trans-unit id="gRiag_n">
                <source>label.email_text_legal</source>
                <target>Menciones legales adicionales del correo</target>
            </trans-unit>
            <trans-unit id="S7SABir">
                <source>label.email_text_no_spam</source>
                <target>Texto anti-spam del correo</target>
            </trans-unit>
            <trans-unit id="cPmYzbj">
                <source>label.email_text_sent_by</source>
                <target>Mención "Enviado por" del correo</target>
            </trans-unit>
            <trans-unit id="wkcUWqy">
                <source>label.healthcheck_pagespeed_api_key</source>
                <target>Clave API de PageSpeed Insights</target>
            </trans-unit>
            <trans-unit id="xZcUaF_">
                <source>label.site_enable_matomo</source>
                <target>Activar estadísticas de Matomo</target>
            </trans-unit>
            <trans-unit id="EDDAHIQ">
                <source>label.site_matomo_id</source>
                <target>ID del sitio Matomo</target>
            </trans-unit>
            <trans-unit id="HoL37ro">
                <source>label.site_matomo_url</source>
                <target>URL de Matomo</target>
            </trans-unit>
            <trans-unit id="vnrrGUG">
                <source>label.site_menu_link_copyright_auto</source>
                <target>Copyright automático en el enlace de menú "Copyright"</target>
            </trans-unit>
            <trans-unit id="xYIFis1">
                <source>label.site_navbar_position</source>
                <target>Posición de la barra de navegación</target>
            </trans-unit>
            <trans-unit id="GKSaIC2">
                <source>label.site_navbar_show_name</source>
                <target>Mostrar el nombre del sitio en la barra de navegación</target>
            </trans-unit>
            <trans-unit id="MhX0IMV">
                <source>label.site_preconnect</source>
                <target>URLs de preconexión</target>
            </trans-unit>
            <trans-unit id="tN9lVY3">
                <source>label.site_tagline</source>
                <target>Eslogan del sitio</target>
            </trans-unit>
        </body>
