parameters:
	ignoreErrors:
		-
			message: '#^Cannot call method setFormTypeOption\(\) on EasyCorp\\Bundle\\EasyAdminBundle\\Contracts\\Field\\FieldInterface\|string\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Controller/Management/UserCrudController.php

		-
			message: '#^Property c975L\\SiteBundle\\Entity\\CollectionItem\:\:\$updatedAt is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Entity/CollectionItem.php

		-
			message: '#^Property c975L\\SiteBundle\\Entity\\Menu\:\:\$blocks is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Entity/Menu.php

		-
			message: '#^Property c975L\\SiteBundle\\Entity\\Page\:\:\$blocks is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Entity/Page.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Management/DeclaredUrlsHealthCheckProvider.php

		-
			message: '#^Offset ''loc'' on array\{loc\: string, lastmod\?\: string, changefreq\?\: string, priority\?\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Management/DeclaredUrlsHealthCheckProvider.php

		-
			message: '#^Method c975L\\SiteBundle\\Management\\SslCertificateHealthCheckProvider\:\:runChecks\(\) should return list\<array\{url\: string, label\?\: string\|null, status\: ''error''\|''ok''\|''skipped''\|''warning'', summary\: string, details\?\: string\|null, editUrl\?\: string\|null\}\> but returns array\{array\{url\: mixed, label\: null, status\: ''error'', summary\: string, details\: array\{error\: string\}\}\}\.$#'
			identifier: return.type
			count: 1
			path: src/Management/SslCertificateHealthCheckProvider.php

		-
			message: '#^Method c975L\\SiteBundle\\Management\\SslCertificateHealthCheckProvider\:\:runChecks\(\) should return list\<array\{url\: string, label\?\: string\|null, status\: ''error''\|''ok''\|''skipped''\|''warning'', summary\: string, details\?\: string\|null, editUrl\?\: string\|null\}\> but returns array\{array\{url\: mixed, label\: null, status\: ''skipped'', summary\: string, details\: array\{\}\}\}\.$#'
			identifier: return.type
			count: 1
			path: src/Management/SslCertificateHealthCheckProvider.php

		-
			message: '#^Method c975L\\SiteBundle\\Management\\SslCertificateHealthCheckProvider\:\:runChecks\(\) should return list\<array\{url\: string, label\?\: string\|null, status\: ''error''\|''ok''\|''skipped''\|''warning'', summary\: string, details\?\: string\|null, editUrl\?\: string\|null\}\> but returns array\{array\{url\: mixed, label\: null, status\: string, summary\: string, details\: array\{expiresAt\: non\-falsy\-string, daysLeft\: int\}\}\}\.$#'
			identifier: return.type
			count: 1
			path: src/Management/SslCertificateHealthCheckProvider.php

		-
			message: '#^Call to an undefined method DOMNameSpaceNode\|DOMNode\:\:getAttribute\(\)\.$#'
			identifier: method.notFound
			count: 5
			path: src/Service/ContentQualityClient.php

		-
			message: '#^Call to an undefined method Symfony\\Component\\Security\\Core\\User\\PasswordAuthenticatedUserInterface\:\:setPassword\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Service/PasswordResetter.php

		-
			message: '#^Call to an undefined method Symfony\\Component\\Security\\Core\\User\\PasswordAuthenticatedUserInterface&Symfony\\Component\\Security\\Core\\User\\UserInterface\:\:setPassword\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Service/UserRegistrar.php
